# Local OLAP database. Leave as-is for the default repository-root path,
# or set an absolute path to your existing market_data.duckdb.
OLAP_DB_PATH=market_data.duckdb

# Rotate any credentials previously hard-coded in the public repository.
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=
INDIAN_API_KEY=
GEMINI_API_KEY=

# Optional legacy migration script source (only if you use that script).
PG_TO_DUCKDB_SOURCE_URL=

# Production-stage variables. Leave unset during local DuckDB development.
SUPABASE_MIGRATION_DB_URL=
SUPABASE_DB_URL=
APP_ENTRYPOINT=unified_app.py
